CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    DMux(in=load, sel=address[14], a=dmux1, b=dmux2);

    RAM16K(in=in, load=dmux1,
        address=address[0..13], out=ramOut
    );
    
    Screen(in=in, load=dmux2,
        address=address[0..12], out=screenOut
    );
    
    Keyboard(out=kbdOut);

    Mux4Way16(a=ramOut, b=ramOut, c=screenOut, d=kbdOut,
        sel=address[13..14], out=out
    );
}
