// CREATED FROM SCRATCH ON: 1.15.26

/**
 * Exclusive-or gate:
 * if ((a and Not(b)) or (Not(a) and b)) out = 1, else out = 0
 */
CHIP Xor {
    IN a, b;
    OUT out;

    PARTS:
    // 1.15.26
    Nand(a=a, b=b, out=nandOut);
    And(a=a, b=nandOut, out=andA);
    And(a=b, b=nandOut, out=andB);
    Or(a=andA, b=andB, out=out);
}